rules_version = '2';

// Study League security rules (no accounts: join with a name + 4-digit PIN).
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Every browser signs in anonymously. A browser becomes "linked" to a profile by
// joining a free spot (it sets the PIN) or by entering that profile's PIN later.
// - Anyone with the link can read the league.
// - Only linked browsers can change a profile and its study sessions.
// - The 6 spots are profiles/s1 … profiles/s6, so a spot can only be claimed once.
// - PINs live in /secrets, which nobody can read.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A browser is linked only if its stored PIN matches the spot's current PIN.
    function linked(pid) {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(pid)/devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(pid)/devices/$(request.auth.uid)).data.pin
           == get(/databases/$(database)/documents/secrets/$(pid)).data.pin;
    }
    function validSlot(pid) { return pid in ['s1', 's2', 's3', 's4', 's5', 's6']; }

    function validProfile(pid, d) {
      return d.slot is int && ('s' + string(d.slot)) == pid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.avatar is string && d.avatar.size() <= 16;
    }

    function validSession(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hours is number && d.hours > 0 && d.hours <= 24
        && (!('subject' in d) || (d.subject is string && d.subject.size() <= 40))
        && (!('bonus' in d) || (d.bonus is int && d.bonus >= 0 && d.bonus <= 520));
    }

    function validReaction(d) {
      return d.emoji in ['🔥', '👏', '💀'] && d.target is string && d.sid is string;
    }

    // The league join code. Set by the owner in the Firebase console; nobody can read or change it from the site.
    match /config/{doc} {
      allow read, write: if false;
    }

    // PIN for each spot. Write-once while the spot is still free; never readable.
    // Claiming a spot also requires the correct league join code.
    match /secrets/{pid} {
      allow read: if false;
      allow create, update: if signedIn() && validSlot(pid)
        && !exists(/databases/$(database)/documents/profiles/$(pid))
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$')
        && request.resource.data.code is string
        && request.resource.data.code == get(/databases/$(database)/documents/config/join).data.code;
      allow delete: if false;
    }

    match /profiles/{pid} {
      allow read: if signedIn();
      // Claim a free spot: must link this browser in the same batch.
      allow create: if signedIn() && validSlot(pid) && validProfile(pid, request.resource.data)
        && existsAfter(/databases/$(database)/documents/profiles/$(pid)/devices/$(request.auth.uid));
      allow update: if linked(pid) && validProfile(pid, request.resource.data);
      allow delete: if false;

      // Browsers allowed to edit this profile. Linking requires the correct PIN.
      match /devices/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.pin is string
          && request.resource.data.pin == getAfter(/databases/$(database)/documents/secrets/$(pid)).data.pin;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow create, update: if linked(pid) && validSession(request.resource.data);
        allow delete: if linked(pid);
      }

      // Achievement unlock records (shown in the live feed). Can't be deleted.
      match /achievements/{aid} {
        allow read: if signedIn();
        allow create, update: if linked(pid) && aid.size() <= 24 && request.resource.data.at is int;
        allow delete: if false;
      }

      // Reactions this player gave to other players' sessions.
      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create, update: if linked(pid) && validReaction(request.resource.data);
        allow delete: if linked(pid);
      }
    }

    // Profile pictures: one small image per spot, changeable only by that player.
    match /photos/{pid} {
      allow read: if signedIn();
      allow create, update: if validSlot(pid) && linked(pid)
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000
        && request.resource.data.data.matches('data:image/(jpeg|png|webp);base64,.+');
      allow delete: if linked(pid);
    }

    // Custom profile banners: one image per spot, changeable only by that player.
    match /banners/{pid} {
      allow read: if signedIn();
      allow create, update: if validSlot(pid) && linked(pid)
        && request.resource.data.data is string
        && request.resource.data.data.size() < 400000
        && request.resource.data.data.matches('data:image/(jpeg|png|webp);base64,.+');
      allow delete: if linked(pid);
    }

    // GIFs are stored as a GIPHY id + size (the app builds the GIPHY URL itself).
    function validGif(g) {
      return g is map && g.keys().hasOnly(['id', 'w', 'h'])
        && g.id is string && g.id.matches('^[A-Za-z0-9]{4,40}$') && g.w is number && g.h is number;
    }
    function postOwner(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.pid;
    }

    // Posts: text and/or one photo (small JPEG) or GIF. Post only as yourself; delete only your own.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if request.resource.data.pid is string && validSlot(request.resource.data.pid)
        && linked(request.resource.data.pid)
        && request.resource.data.keys().hasOnly(['pid', 'text', 'img', 'gif', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.at is int
        && (!('img' in request.resource.data) || (request.resource.data.img is string
            && request.resource.data.img.size() < 900000
            && request.resource.data.img[0:23] == 'data:image/jpeg;base64,'))
        && (!('gif' in request.resource.data) || validGif(request.resource.data.gif))
        && (request.resource.data.text.size() > 0 || 'img' in request.resource.data || 'gif' in request.resource.data);
      allow update: if false;
      allow delete: if resource.data.pid is string && linked(resource.data.pid);
    }

    // Comments on posts. The comment's author or the post's author can delete it.
    match /postComments/{commentId} {
      allow read: if signedIn();
      allow create: if request.resource.data.pid is string && validSlot(request.resource.data.pid)
        && linked(request.resource.data.pid)
        && request.resource.data.keys().hasOnly(['post', 'pid', 'text', 'gif', 'at'])
        && request.resource.data.post is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.post))
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.at is int
        && (!('gif' in request.resource.data) || validGif(request.resource.data.gif))
        && (request.resource.data.text.size() > 0 || 'gif' in request.resource.data);
      allow update: if false;
      allow delete: if (resource.data.pid is string && linked(resource.data.pid))
        || (exists(/databases/$(database)/documents/posts/$(resource.data.post)) && linked(postOwner(resource.data.post)));
    }

    // One reaction per player per post: id is "<postId>__<spot>".
    match /postReacts/{reactId} {
      allow read: if signedIn();
      allow create, update: if request.resource.data.pid is string && validSlot(request.resource.data.pid)
        && linked(request.resource.data.pid)
        && reactId == request.resource.data.post + '__' + request.resource.data.pid
        && request.resource.data.emoji in ['🔥', '😂', '💀', '❤️']
        && request.resource.data.at is int;
      allow delete: if (resource.data.pid is string && linked(resource.data.pid))
        || (exists(/databases/$(database)/documents/posts/$(resource.data.post)) && linked(postOwner(resource.data.post)));
    }

    // League chat: anyone in the league reads; you can only post as yourself and delete your own.
    match /chat/{msgId} {
      allow read: if signedIn();
      allow create: if request.resource.data.pid is string && validSlot(request.resource.data.pid)
        && linked(request.resource.data.pid)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
        && request.resource.data.at is int;
      allow update: if false;
      allow delete: if resource.data.pid is string && linked(resource.data.pid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
