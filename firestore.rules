rules_version = '2';

// Study League security rules (no accounts: join with a name + 4-digit PIN).
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Every browser signs in anonymously. A browser becomes "linked" to a profile by
// joining a free spot (it sets the PIN) or by entering that profile's PIN later.
// - Anyone with the link can read the league.
// - Only linked browsers can change a profile and its study sessions.
// - The 6 spots are profiles/s1 … profiles/s6, so a spot can only be claimed once.
// - PINs live in /secrets, which nobody can read.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A browser is linked only if its stored PIN matches the spot's current PIN.
    function linked(pid) {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(pid)/devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(pid)/devices/$(request.auth.uid)).data.pin
           == get(/databases/$(database)/documents/secrets/$(pid)).data.pin;
    }
    function validSlot(pid) { return pid in ['s1', 's2', 's3', 's4', 's5', 's6']; }

    function validProfile(pid, d) {
      return d.slot is int && ('s' + string(d.slot)) == pid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.avatar is string && d.avatar.size() <= 16;
    }

    function validSession(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hours is number && d.hours > 0 && d.hours <= 24
        && (!('subject' in d) || (d.subject is string && d.subject.size() <= 40))
        && (!('bonus' in d) || (d.bonus is int && d.bonus >= 0 && d.bonus <= 520));
    }

    function validReaction(d) {
      return d.emoji in ['🔥', '👏', '💀'] && d.target is string && d.sid is string;
    }

    // PIN for each spot. Write-once while the spot is still free; never readable.
    match /secrets/{pid} {
      allow read: if false;
      allow create, update: if signedIn() && validSlot(pid)
        && !exists(/databases/$(database)/documents/profiles/$(pid))
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$');
      allow delete: if false;
    }

    match /profiles/{pid} {
      allow read: if signedIn();
      // Claim a free spot: must link this browser in the same batch.
      allow create: if signedIn() && validSlot(pid) && validProfile(pid, request.resource.data)
        && existsAfter(/databases/$(database)/documents/profiles/$(pid)/devices/$(request.auth.uid));
      allow update: if linked(pid) && validProfile(pid, request.resource.data);
      allow delete: if false;

      // Browsers allowed to edit this profile. Linking requires the correct PIN.
      match /devices/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.pin is string
          && request.resource.data.pin == getAfter(/databases/$(database)/documents/secrets/$(pid)).data.pin;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow create, update: if linked(pid) && validSession(request.resource.data);
        allow delete: if linked(pid);
      }

      // Reactions this player gave to other players' sessions.
      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create, update: if linked(pid) && validReaction(request.resource.data);
        allow delete: if linked(pid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
