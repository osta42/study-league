rules_version = '2';

// Study League security rules.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// - Anyone signed in can READ the league (profiles, hours, who is online).
// - Each person can only WRITE their own profile (members/<their uid>)
//   and their own study sessions (members/<their uid>/sessions/...).
// - Nobody can edit or delete anyone else's data from the website.
//   (The project owner can still fix things by hand in the Firebase console.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function validMember(d) {
      return d.slot is int && d.slot >= 1 && d.slot <= 6
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.avatar is string && d.avatar.size() <= 16;
    }

    function validSession(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hours is number && d.hours > 0 && d.hours <= 24
        && (!('subject' in d) || (d.subject is string && d.subject.size() <= 40));
    }

    match /members/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && validMember(request.resource.data);
      allow delete: if isSelf(uid);

      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid) && validSession(request.resource.data);
        allow delete: if isSelf(uid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
